# Base URL of the FastAPI backend. Leave empty in local dev — Vite proxies
# `/api` and `/health` to http://127.0.0.1:8000 (see vite.config.ts).
VITE_API_BASE_URL=

# Name of the CSRF cookie set by the backend; read by the SPA on mutations.
VITE_CSRF_COOKIE_NAME=ums_csrf

# Optional demo credentials surfaced by the "Use demo credentials" link on the
# login page. Leave empty to hide that affordance entirely.
VITE_DEMO_EMAIL=admin@example.com
VITE_DEMO_PASSWORD=ChangeMe123!!
