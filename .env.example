APP_NAME=University Management System
ENVIRONMENT=development
DEBUG=true
SHOW_DOCS=true
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ISSUER=ums-api
JWT_AUDIENCE=ums-spa
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/university_management
# Redis mapped to host port 6300 in docker-compose.yml to avoid Windows port exclusions
REDIS_URL=redis://127.0.0.1:6300/0
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_COOKIE_NAME=ums_access
REFRESH_COOKIE_NAME=ums_refresh
CSRF_COOKIE_NAME=ums_csrf
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_IP_RATE_LIMIT_ATTEMPTS=20
LOGIN_IP_RATE_LIMIT_WINDOW_SECONDS=60
API_READ_RATE_LIMIT_ATTEMPTS=300
API_READ_RATE_LIMIT_WINDOW_SECONDS=60
API_WRITE_RATE_LIMIT_ATTEMPTS=60
API_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
CHANGE_PASSWORD_RATE_LIMIT_ATTEMPTS=5
CHANGE_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=300
REFRESH_RATE_LIMIT_ATTEMPTS=10
REFRESH_RATE_LIMIT_WINDOW_SECONDS=300
CSRF_FAILURE_RATE_LIMIT_ATTEMPTS=20
CSRF_FAILURE_RATE_LIMIT_WINDOW_SECONDS=300
